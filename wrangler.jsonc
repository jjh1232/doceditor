{
  // Cloudflare Workers (Static Assets). 빌드 결과 dist/ 를 올린다 (Astro — 헌법 §4).
  //
  // ⚠ directory 를 "." 으로 바꾸지 말 것. 저장소 루트를 올리면 docs/ 와 CLAUDE.md 가 같이 공개된다.
  "name": "doceditor",
  "compatibility_date": "2026-08-15",

  // 자산 앞단에서 /doceditor 접두사를 떼고, 언어 없는 /doceditor 을 언어판으로 302 한다.
  "main": "./worker/index.js",

  // 끝 슬래시 없는 주소를 쓰므로 /doceditor 자체도 이 Worker 가 받는다.
  // (순수 HTML 도구는 /<도구> 를 라우터가 /<도구>/ 로 301 했지만, 여기서는 그럴 필요가 없다)
  // prelaps-router 의 prelaps.com/* 와 겹치지만 더 구체적인 라우트가 이긴다.
  // 커스텀 도메인은 붙이지 않는다 — 같은 내용이 두 주소로 열려 중복 콘텐츠가 된다.
  //
  // ⚠ "prelaps.com/doceditor" 와 "/doceditor/*" 두 개로 나누지 말 것. 끝에 * 가 없는 패턴은
  // 쿼리가 붙은 /doceditor?utm_source=… 에 안 걸려 라우터 → 허브 404 로 떨어진다 (2026-09-16 라이브에서 확인).
  // /doceditorxyz 도 여기 걸리지만 Worker 가 「접두사로 시작만 하는 경로」 로 보고 404 를 준다.
  "routes": [
    { "pattern": "prelaps.com/doceditor*", "zone_name": "prelaps.com" }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // 기본은 「자산 먼저, 없으면 Worker」 라 접두사를 떼기 전에 조회가 빗나간다. 순서를 뒤집는다.
    "run_worker_first": true,

    // astro.config 의 trailingSlash:'never' + build.format:'file' 과 세트다.
    // /ko → ko.html 200, /ko/ → /ko 로 리다이렉트. canonical·sitemap 이 전부 끝 슬래시 없음.
    "html_handling": "drop-trailing-slash",

    // 없는 주소는 404.html 을 status 404 로. 없으면 soft 404 가 된다.
    "not_found_handling": "404-page"
  }
}
